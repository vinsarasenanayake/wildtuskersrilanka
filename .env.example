# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# NEVER put real keys in this file — it is uploaded to GitHub.

# ── Supabase (Dashboard → Project Settings → API Keys) ──────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Google Maps (Google Cloud Console → Credentials → Places API enabled) ──
VITE_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ── Only for scripts on your laptop. NEVER add this to Vercel. ──
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
