# Copy this file to .env.local and fill in the values. .env.local is git-ignored.

# ── Supabase (Dashboard → Project Settings → API Keys) ──────────
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-OR-PUBLISHABLE-KEY

# ── Cloudflare R2 photo storage (server-side only — never prefix with VITE_) ──
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_PUBLIC_BUCKET=wts-public
R2_ORIGINALS_BUCKET=wts-originals
R2_PUBLIC_BASE_URL=https://pub-89a7419de3a14bd48e5d0638eeb714e9.r2.dev

# ── Only for the one-time scripts on your laptop. NEVER add this to Vercel. ──
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key
